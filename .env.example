# Copy to .env for local development.

# Folder holding the SQLite database and uploaded files (logo, favicon).
DATA_DIR=./storage

# Used by the Prisma CLI (migrate). Relative paths resolve from the prisma/ folder.
DATABASE_URL=file:../storage/infradev.db

# First-run admin account (only used when no admin exists yet).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# Secret used to sign admin session cookies. If empty, one is generated and
# stored in DATA_DIR/.session_secret on first start.
SESSION_SECRET=
